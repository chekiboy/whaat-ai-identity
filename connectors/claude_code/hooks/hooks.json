{
  "description": "whaat memory hooks: the core, the indexes and the memory map at session start (SessionStart), the same for a subagent (SubagentStart), a recalled memory as a note, and direct reads and writes of memory pointed to whaat. Each hook runs its stdlib script through uv, a real program on every system (exec form), so no shell or python3 name is assumed; --no-config keeps the session repo's Python pins and uv settings out.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "statusMessage": "Loading memory...",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "--quiet",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start",
              "--context",
              "index",
              "1/7"
            ]
          }
        ]
      },
      {
